# pnpm 11 build-script policy:
# esbuild's postinstall is blocked by default, but the @esbuild/win32-x64 binary
# is already present, so vite builds fine without running it. Skip pnpm's
# pre-run dependency verification, which otherwise aborts with
# ERR_PNPM_IGNORED_BUILDS and prevents `pnpm build` / `tauri build`.
verify-deps-before-run=false
# Skip ALL dependency lifecycle scripts (esbuild/@tauri-apps/cli only ship
# prebuilt platform binaries, no native build needed). This guarantees that any
# `pnpm install` invocation — including the one Tauri 2 CLI runs internally as a
# dependency check before beforeBuildCommand — exits 0 instead of failing with
# ERR_PNPM_IGNORED_BUILDS (Tauri treats that non-zero exit as fatal).
ignore-scripts=true
